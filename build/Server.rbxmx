<roblox version="4">
  <Item class="Folder" referent="0">
    <Properties>
      <string name="Name">Server</string>
    </Properties>
    <Item class="Script" referent="1">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	Server-side game logic.

	Runs in ServerScriptService, so players can never see or edit it. Anything
	that decides "did you really earn this?" belongs here — never on the client.

	What it does:
	  1. Loads each player's saved progress, then gives them a `leaderstats`
	     folder (this is what makes the scoreboard in the top-right appear).
	  2. Spawns floating coins around the baseplate.
	  3. Awards points when a player touches one, then respawns it.
	  4. Saves progress on a timer, on leave, and on server shutdown.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local PlayerData = require(script.Parent.PlayerData)
local ShopService = require(script.Parent.ShopService)
local World = require(script.Parent.World)

--[[
	WaitForChild with a deadline and a real explanation.

	A bare WaitForChild never gives up, so a missing instance does not error —
	the script just stops, silently, forever. That is harder to diagnose than a
	crash, because the Output window stays empty. This turns it into a named
	failure that says which instance and where to add it.
]]
local function expect(parent: Instance, name: string, where: string): Instance
	local found = parent:WaitForChild(name, 10)
	if not found then
		error(
			string.format(
				"[%s] Missing %s.%s after 10s. Declare it under %s in the project file.",
				where,
				parent.Name,
				name,
				where
			),
			0
		)
	end
	return found
end

local Remotes = expect(ReplicatedStorage, "Remotes", "ReplicatedStorage")
local coinCollected = expect(Remotes, "CoinCollected", "ReplicatedStorage/Remotes") :: RemoteEvent
local inventoryChanged =
	expect(Remotes, "InventoryChanged", "ReplicatedStorage/Remotes") :: RemoteEvent
local purchaseItem = expect(Remotes, "PurchaseItem", "ReplicatedStorage/Remotes") :: RemoteFunction
local setSprinting = expect(Remotes, "SetSprinting", "ReplicatedStorage/Remotes") :: RemoteEvent

local COIN_TAG = "Coin"

--[[
	Build terrain and scenery first: coins are placed relative to the ground, so
	the ground has to exist and its shape has to be known.

	Wrapped, because scenery is the least important thing in this script and was
	briefly the only thing that mattered — a missing Terrain instance threw, and
	took leaderstats, coins, saving and the shop down with it. A world that
	fails to generate should cost you the world, not the game.
]]
local housePosition = Vector3.new(0, 0, -Config.clearingRadius * 0.55)

local worldOk, worldErr = pcall(function()
	housePosition = World.build()
end)

if not worldOk then
	warn("[Main] World generation failed: " .. tostring(worldErr))
	warn("[Main] Everything else still runs. Check the Output window for the error above.")
end

local coinFolder = Instance.new("Folder")
coinFolder.Name = "Coins"
coinFolder.Parent = Workspace

--[[
	Load the player's save, then set up their scoreboard entry. Roblox looks for
	a folder named exactly "leaderstats" inside the Player, and shows each value
	inside it.
]]
local function onPlayerAdded(player: Player)
	-- Load before building leaderstats, so the scoreboard shows the real total
	-- immediately instead of flashing 0 and then jumping.
	PlayerData.load(player)

	-- Loading yields on a network call, so the player may have left while we
	-- waited. Building UI on a departed player leaks the profile.
	if not player:IsDescendantOf(Players) then
		PlayerData.release(player)
		return
	end

	local profile = PlayerData.get(player)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = if profile then profile.coins else 0
	coins.Parent = leaderstats

	leaderstats.Parent = player

	-- Re-apply bonuses on every respawn, not just this one — a new character
	-- starts with default WalkSpeed and JumpPower.
	player.CharacterAdded:Connect(function()
		ShopService.applyEffects(player)
	end)

	if player.Character then
		ShopService.applyEffects(player)
	end

	inventoryChanged:FireClient(player, ShopService.inventoryOf(player))
end

-- The profile is the source of truth; the IntValue is only what the scoreboard
-- reads. Anything that changes coins updates the profile, then calls this.
local function syncLeaderstats(player: Player)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end

	local coins = leaderstats:FindFirstChild("Coins")
	if coins and coins:IsA("IntValue") then
		coins.Value = profile.coins
	end
end

local function awardCoins(player: Player, amount: number)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end

	profile.coins += amount
	syncLeaderstats(player)
end

--[[
	A random point in a disc around the origin, floating just above the ground.

	Taking the square root of the random number spreads coins evenly instead of
	bunching them in the middle. Height comes from the same noise function the
	terrain was built from, so a coin on a hillside floats at the same height
	above the slope as one on flat ground.

	Points landing inside the cabin footprint are retried rather than nudged —
	nudging would pile coins against its walls.
]]
local function randomCoinPosition(): Vector3
	for _ = 1, 30 do
		local angle = math.random() * math.pi * 2
		local distance = math.sqrt(math.random()) * Config.coinSpawnRadius

		local x = math.cos(angle) * distance
		local z = math.sin(angle) * distance

		local insideCabin = math.abs(x - housePosition.X) < 18
			and math.abs(z - housePosition.Z) < 16
		if not insideCabin then
			return Vector3.new(x, World.heightAt(x, z) + Config.coinHeight, z)
		end
	end

	-- Every attempt hit the cabin, which should not happen with these numbers.
	-- Fall back to somewhere valid rather than looping forever.
	return Vector3.new(0, World.heightAt(0, 0) + Config.coinHeight, Config.coinSpawnRadius * 0.8)
end

local function spawnCoin()
	local coin = Instance.new("Part")
	coin.Name = "Coin"
	coin.Shape = Enum.PartType.Cylinder
	coin.Size = Vector3.new(0.4, 3, 3)
	coin.Color = Color3.fromRGB(255, 201, 61)
	coin.Material = Enum.Material.Neon
	coin.Anchored = true
	coin.CanCollide = false
	coin.CFrame = CFrame.new(randomCoinPosition())

	-- Touched can fire many times per contact, so guard against double-awards.
	local collected = false

	coin.Touched:Connect(function(hit: BasePart)
		if collected then
			return
		end

		local character = hit.Parent
		if not character or not character:FindFirstChildOfClass("Humanoid") then
			return
		end

		local player = Players:GetPlayerFromCharacter(character :: Model)
		if not player then
			return
		end

		collected = true
		coin.CanTouch = false
		coin.Transparency = 1

		-- Lucky Charm and friends are applied here, on the server. The client
		-- is only told the result so it can show the right number.
		local amount = math.floor(Config.coinValue * ShopService.coinMultiplier(player))
		awardCoins(player, amount)
		coinCollected:FireClient(player, amount)

		task.delay(Config.coinRespawnSeconds, function()
			coin.CFrame = CFrame.new(randomCoinPosition())
			coin.Transparency = 0
			coin.CanTouch = true
			collected = false
		end)
	end)

	-- Tagging lets the client find every coin without hardcoding paths.
	CollectionService:AddTag(coin, COIN_TAG)
	coin.Parent = coinFolder
end

--[[
	The one entry point a client has into the shop. It returns (ok, message)
	rather than throwing, so a failed purchase is a message on screen instead
	of an error in the client's console.
]]
purchaseItem.OnServerInvoke = function(player: Player, itemId: unknown)
	local ok, message = ShopService.purchase(player, itemId)

	if ok then
		syncLeaderstats(player)
		ShopService.applyEffects(player)
		inventoryChanged:FireClient(player, ShopService.inventoryOf(player))
	end

	return ok, message
end

--[[
	The client tells us when Shift goes down and up. Sprint state lives on the
	server so it composes with shop bonuses in one place — the client cannot
	pick its own speed, only say which of two states it is in.
]]
setSprinting.OnServerEvent:Connect(function(player: Player, isSprinting: unknown)
	ShopService.setSprinting(player, isSprinting == true)
end)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	ShopService.clearSprinting(player)
	PlayerData.release(player)
end)

-- In Studio the local player can join before this script runs, so catch anyone
-- who is already here. task.spawn because onPlayerAdded yields.
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

for _ = 1, Config.coinCount do
	spawnCoin()
end

-- Autosave, so a server crash costs a minute of progress rather than all of it.
task.spawn(function()
	while true do
		task.wait(Config.autosaveSeconds)

		for _, player in Players:GetPlayers() do
			task.spawn(PlayerData.save, player)
		end
	end
end)

--[[
	PlayerRemoving does not reliably finish when the whole server is shutting
	down, so save everyone one last time here. Roblox allows roughly 30 seconds
	before killing the server, and saves run concurrently to stay well inside
	that.
]]
game:BindToClose(function()
	local players = Players:GetPlayers()
	local pending = #players

	if pending == 0 then
		return
	end

	for _, player in players do
		task.spawn(function()
			PlayerData.save(player)
			pending -= 1
		end)
	end

	while pending > 0 do
		task.wait()
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">PlayerData</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Saving and loading player progress with DataStoreService.

	Roblox gives every experience a key-value database that survives server
	restarts. It is also the single easiest place in Roblox to lose player data,
	so this module is deliberately paranoid:

	  * Every request is wrapped in pcall. DataStore calls are network calls and
	    they DO fail — treating a failure as "no data" is how saves get wiped.
	  * A profile is only saved if it was successfully loaded first. See the
	    guard in save(); it is the most important line in this file.
	  * Loaded data is reconciled against a default template, so adding a new
	    field later does not break players whose save predates it.
]]

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

export type Profile = {
	coins: number,
	-- Shop item ids this player has bought, as a set.
	owned: { [string]: boolean },
}

local DEFAULT_PROFILE: Profile = {
	coins = 0,
	owned = {},
}

--[[
	Data stores belong to the whole experience, not to one place — every place
	in a game, and every live server, reads the same database. Studio is no
	exception: once this place is published and Studio API access is on, a
	playtest reads and writes the SAME saves your real players use. A bad save
	routine tested in Studio can therefore corrupt live data.

	Branching the name gives Studio its own sandbox. This is a convention held
	up by this one line, not a guarantee — the stronger version is a separately
	published test experience, which gets different data stores outright. Doing
	both means two things have to fail before real saves are at risk.

	Bump the version suffix if you ever change Profile's shape in a way old
	saves can't be reconciled into; old data is then left untouched under the
	old name rather than corrupted.
]]
local STORE_NAME = if RunService:IsStudio() then "PlayerData_v1_studio" else "PlayerData_v1"

--[[
	Resolved at startup, and nil when persistence is not possible.

	GetDataStore is itself a failing call in an unpublished place — it throws
	"You must publish this place to the web to access DataStore" rather than
	handing back a store whose requests later fail. So it cannot sit bare at
	module scope: doing so made requiring this module throw, which took the
	whole server script down with it.
]]
local store: DataStore? = nil
local KEY_PREFIX = "Player_"

local MAX_ATTEMPTS = 3
local PROBE_KEY = "__availability_probe__"

--[[
	Whether this server can reach the DataStore at all.

	Decided once at startup rather than per player. Data stores belong to a
	published experience, so in a local unpublished .rbxl every request fails
	the same way — retrying three times on each join would stall every player
	for seconds and bury the console in identical warnings.

	Starts false and is only turned on once a real request has come back. The
	safe assumption is that saving does not work.
]]
local storesAvailable = false

local profiles: { [number]: Profile } = {}
-- True only once we have actually heard back from the DataStore for this
-- player — including "you have no save yet", which is a valid answer.
local isLoaded: { [number]: boolean } = {}

local PlayerData = {}

local function keyFor(player: Player): string
	return KEY_PREFIX .. tostring(player.UserId)
end

--[[
	Run a DataStore call, retrying with exponential backoff. Returns
	(success, result) — never throws.
]]
local function withRetry(label: string, operation: () -> any): (boolean, any)
	local backoff = 1

	for attempt = 1, MAX_ATTEMPTS do
		local ok, result = pcall(operation)
		if ok then
			return true, result
		end

		warn(
			string.format(
				"[PlayerData] %s failed (%d/%d): %s",
				label,
				attempt,
				MAX_ATTEMPTS,
				tostring(result)
			)
		)

		-- By far the most common cause in Studio, and the error text is not
		-- obvious about the fix.
		if
			string.find(tostring(result), "403") or string.find(tostring(result), "API Services")
		then
			warn(
				"[PlayerData] In Studio, tick Game Settings -> Security -> Enable Studio Access to API Services."
			)
		end

		if attempt < MAX_ATTEMPTS then
			task.wait(backoff)
			backoff *= 2
		end
	end

	return false, nil
end

-- Copy known fields off whatever came back, ignoring anything unexpected. A
-- save written by an older version of the game is missing newer fields, and
-- picks up their defaults here.
local function reconcile(stored: any): Profile
	-- Fresh tables, never shared with DEFAULT_PROFILE — two players must not
	-- end up mutating the same `owned` table.
	local profile: Profile = { coins = DEFAULT_PROFILE.coins, owned = {} }

	if typeof(stored) ~= "table" then
		return profile
	end

	if typeof(stored.coins) == "number" then
		profile.coins = stored.coins
	end

	-- Saves written before the shop existed have no `owned` field and simply
	-- keep the empty default.
	if typeof(stored.owned) == "table" then
		for id, isOwned in stored.owned do
			if typeof(id) == "string" and isOwned == true then
				profile.owned[id] = true
			end
		end
	end

	return profile
end

--[[
	Fetch this player's save. Yields. Always leaves a usable profile in memory,
	even on failure — but marks an unrecoverable one as unsaveable so a later
	save() cannot clobber real data with defaults.
]]
function PlayerData.load(player: Player)
	local userId = player.UserId

	-- Already known to be offline: hand back a fresh profile immediately and
	-- skip the doomed round trip. The game plays normally, it just won't save.
	if not storesAvailable then
		profiles[userId] = reconcile(nil)
		isLoaded[userId] = false
		return
	end

	-- Copied to a local so Luau can narrow away the optional.
	local activeStore = store
	if not activeStore then
		profiles[userId] = reconcile(nil)
		isLoaded[userId] = false
		return
	end

	local ok, stored = withRetry("load " .. player.Name, function()
		return activeStore:GetAsync(keyFor(player))
	end)

	if not ok then
		profiles[userId] = reconcile(nil)
		isLoaded[userId] = false
		warn(string.format("[PlayerData] %s is playing on an unsaved session.", player.Name))
		return
	end

	profiles[userId] = reconcile(stored)
	isLoaded[userId] = true
end

function PlayerData.get(player: Player): Profile?
	return profiles[player.UserId]
end

--[[
	Write this player's profile back. Yields. Returns whether it stuck.
]]
function PlayerData.save(player: Player): boolean
	local userId = player.UserId
	local profile = profiles[userId]

	if not profile then
		return false
	end

	-- Nothing to say here; the reason was already reported once at startup.
	if not storesAvailable then
		return false
	end

	-- THE important guard. If the load failed we do not know what this player
	-- already had, so writing now would replace a real save with a fresh zero.
	-- Losing one session of progress is bad; erasing everything is worse.
	if not isLoaded[userId] then
		warn(
			string.format(
				"[PlayerData] refusing to save %s — their data never loaded.",
				player.Name
			)
		)
		return false
	end

	local activeStore = store
	if not activeStore then
		return false
	end

	local ok = withRetry("save " .. player.Name, function()
		-- UpdateAsync rather than SetAsync: it serialises against a concurrent
		-- write from another server, which happens when a player rejoins fast
		-- enough that their old session is still shutting down.
		activeStore:UpdateAsync(keyFor(player), function()
			return profile
		end)
		return nil
	end)

	return ok
end

--[[
	Save and forget a player. Safe to call more than once.
]]
function PlayerData.release(player: Player)
	PlayerData.save(player)
	profiles[player.UserId] = nil
	isLoaded[player.UserId] = nil
end

--[[
	Explain, once, why nothing will be saved this session.
]]
local function reportUnavailable(reason: string)
	warn("[PlayerData] Data stores unavailable — progress will NOT be saved this session.")
	warn("[PlayerData] Everything else works; coins and purchases just reset when you stop.")

	if
		string.find(reason, "publish")
		or string.find(reason, "403")
		or string.find(reason, "API Services")
	then
		warn(
			"[PlayerData] To enable saving: publish the place once (File > Publish to Roblox As...),"
		)
		warn(
			'[PlayerData] then tick File > Experience Settings > Security > "Enable Studio Access to API Services".'
		)
	else
		warn("[PlayerData] Reason: " .. reason)
	end
end

--[[
	Work out at server start whether persistence is possible, without ever
	throwing. Two separate calls can fail and both are guarded:

	  1. GetDataStore, which throws outright in an unpublished place.
	  2. The first real request, which can fail even when GetDataStore did not
	     — an unpublished place is not the only reason saving can be off.

	Yields briefly on the second, once, before any player can join.
]]
local function initialiseStore()
	local gotStore, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)

	if not gotStore then
		reportUnavailable(tostring(result))
		return
	end

	local resolved = result :: DataStore

	local reachable, err = pcall(function()
		return resolved:GetAsync(PROBE_KEY)
	end)

	if not reachable then
		reportUnavailable(tostring(err))
		return
	end

	store = resolved
	storesAvailable = true
end

initialiseStore()

return PlayerData
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">ShopService</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Buying things, and the effects of having bought them.

	Every function here treats its arguments as hostile. A RemoteFunction can be
	invoked by an exploiting client with any values it likes — a number where a
	string belongs, an item id that does not exist, a purchase for something
	already owned. The checks in purchase() are the only thing standing between
	that and a free shop.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Shop = require(ReplicatedStorage.Shared.Shop)
local PlayerData = require(script.Parent.PlayerData)

local ShopService = {}

--[[
	Attempt a purchase. Returns (succeeded, message-to-show-the-player).

	itemId is typed `unknown` on purpose: it arrives straight off the wire.
]]
function ShopService.purchase(player: Player, itemId: unknown): (boolean, string)
	if typeof(itemId) ~= "string" then
		return false, "Invalid request."
	end

	-- Look the item up in the shared list rather than trusting anything the
	-- client said about it. The price used below is always ours.
	local item = Shop.getItem(itemId)
	if not item then
		return false, "No such item."
	end

	local profile = PlayerData.get(player)
	if not profile then
		return false, "Your data is still loading — try again in a moment."
	end

	if profile.owned[item.id] then
		return false, "You already own that."
	end

	if profile.coins < item.price then
		return false, string.format("You need %d more coins.", item.price - profile.coins)
	end

	profile.coins -= item.price
	profile.owned[item.id] = true

	return true, string.format("Bought %s!", item.name)
end

--[[
	Total coin multiplier from everything this player owns.
]]
function ShopService.coinMultiplier(player: Player): number
	local profile = PlayerData.get(player)
	if not profile then
		return 1
	end

	local multiplier = 1
	for _, item in Shop.items do
		if profile.owned[item.id] and item.coinMultiplier then
			multiplier *= item.coinMultiplier
		end
	end

	return multiplier
end

--[[
	Push owned movement bonuses onto the player's current character.

	Called on spawn and after a purchase. Always recomputes from the base values
	rather than adding to whatever the humanoid currently has, so calling it
	twice cannot stack a bonus twice.
]]
-- Players currently holding Shift. Cleared on leave by Main.
local sprinting: { [number]: boolean } = {}

function ShopService.setSprinting(player: Player, isSprinting: boolean)
	sprinting[player.UserId] = isSprinting or nil
	ShopService.applyEffects(player)
end

function ShopService.clearSprinting(player: Player)
	sprinting[player.UserId] = nil
end

function ShopService.applyEffects(player: Player)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local walkSpeed = Config.baseWalkSpeed
	local jumpPower = Config.baseJumpPower

	for _, item in Shop.items do
		if profile.owned[item.id] then
			walkSpeed += item.walkSpeedBonus or 0
			jumpPower += item.jumpPowerBonus or 0
		end
	end

	-- Sprint multiplies the total, so Swift Boots make running faster too
	-- rather than being cancelled out by it.
	if sprinting[player.UserId] then
		walkSpeed *= Config.sprintMultiplier
	end

	humanoid.WalkSpeed = walkSpeed
	-- New characters default to the JumpHeight model; switch to JumpPower so
	-- the bonus above means what it says.
	humanoid.UseJumpPower = true
	humanoid.JumpPower = jumpPower
end

--[[
	What the client needs to draw the shop: which ids this player owns.
]]
function ShopService.inventoryOf(player: Player): { [string]: boolean }
	local profile = PlayerData.get(player)
	if not profile then
		return {}
	end

	local owned: { [string]: boolean } = {}
	for id, isOwned in profile.owned do
		if isOwned then
			owned[id] = true
		end
	end

	return owned
end

return ShopService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">World</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Builds the world at server start: terrain, trees and a cabin.

	All of it is generated in code rather than placed by hand in Studio. That
	is a deliberate trade — a hand-built world looks better, but this one costs
	nothing to regenerate, resize or reshape, and every tree is a few numbers
	rather than an hour of clicking.

	Height comes from math.noise, which is deterministic: the same coordinates
	always give the same height, so the terrain is identical on every server
	without storing anything.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local World = {}

--[[
	Set when there is no Terrain to build on and we fall back to a flat Part.
	heightAt then reports level ground, so trees and coins sit on the fallback
	instead of floating at hill heights that no longer exist.
]]
local groundIsFlat = false

-- Colours picked to sit together rather than to be individually pretty.
local BARK = Color3.fromRGB(88, 66, 48)
local LEAF_LIGHT = Color3.fromRGB(104, 150, 68)
local LEAF_DARK = Color3.fromRGB(72, 112, 54)
local WALL = Color3.fromRGB(196, 180, 154)
local BEAM = Color3.fromRGB(96, 72, 52)
local ROOF = Color3.fromRGB(122, 66, 58)
local FLOOR = Color3.fromRGB(142, 108, 74)

-- Smoothstep: 0 below `from`, 1 above `to`, with eased ends rather than a kink.
local function smoothstep(value: number, from: number, to: number): number
	local t = math.clamp((value - from) / (to - from), 0, 1)
	return t * t * (3 - 2 * t)
end

--[[
	How far a point is from the middle of the pond.
]]
function World.distanceToPond(x: number, z: number): number
	local dx = x - Config.pondCenterX
	local dz = z - Config.pondCenterZ
	return math.sqrt(dx * dx + dz * dz)
end

--[[
	Ground height at a point, before anything is built.

	Three things stacked, in order:
	  1. Two octaves of noise — a broad one for hills, a finer one for lumps.
	  2. Flattening, toward zero inside the clearing and around the pond, so the
	     spawn, the cabin and the water line all sit on level ground.
	  3. The pond basin, carved downward.

	Deterministic: the same coordinates always give the same height, so every
	server builds the same world without storing anything.
]]
function World.heightAt(x: number, z: number): number
	if groundIsFlat then
		return 0
	end

	local broad = math.noise(x / 190, z / 190, 7.3)
	local detail = math.noise(x / 55, z / 55, 19.1) * 0.3
	local height = (broad + detail) * Config.hillHeight

	-- Flatten toward the middle.
	local distance = math.sqrt(x * x + z * z)
	height *= smoothstep(
		distance,
		Config.clearingRadius,
		Config.clearingRadius + Config.clearingFalloff
	)

	-- Flatten around the pond too, so its bank is level all the way round
	-- instead of the water line cutting across a hillside.
	local pondDistance = World.distanceToPond(x, z)
	local pondEdge = Config.pondRadius + Config.pondBankWidth
	height *= smoothstep(pondDistance, Config.pondRadius, pondEdge)

	-- Carve the basin: deepest in the middle, easing up to nothing at the rim.
	if pondDistance < Config.pondRadius then
		local bowl = 1 - smoothstep(pondDistance, 0, Config.pondRadius)
		height -= Config.pondDepth * bowl
	end

	return height
end

--[[
	Which material a patch of ground should be.

	Picked from the shape of the land rather than assigned by hand: anything
	near the water line is sand, steep faces are rock, everything else is grass.
	That is what stops the world looking like one flat green sheet.
]]
local function materialAt(x: number, z: number, height: number): Enum.Material
	-- Shoreline: a band of sand either side of the water line, but only near
	-- the pond, so puddle-height ground elsewhere stays grass.
	if World.distanceToPond(x, z) < Config.pondRadius + Config.pondBankWidth * 0.25 then
		if height < Config.waterLevel + 2.5 then
			return Enum.Material.Sand
		end
	end

	-- Slope from finite differences. A tall rise over a short distance reads as
	-- a cliff face, and cliffs are not grassy.
	local step = 5
	local dx = World.heightAt(x + step, z) - World.heightAt(x - step, z)
	local dz = World.heightAt(x, z + step) - World.heightAt(x, z - step)
	local slope = math.sqrt(dx * dx + dz * dz) / (2 * step)

	if slope > 0.62 then
		return Enum.Material.Rock
	elseif slope > 0.4 then
		return Enum.Material.Ground
	end

	return Enum.Material.Grass
end

local function generateTerrain(terrain: Terrain)
	local half = Config.worldSize / 2
	local cell = Config.terrainCell
	local floor = -Config.terrainDepth

	for x = -half, half - cell, cell do
		for z = -half, half - cell, cell do
			-- Sample the centre of the cell rather than a corner, so columns
			-- sit symmetrically on the underlying noise.
			local cx, cz = x + cell / 2, z + cell / 2
			local height = World.heightAt(cx, cz)
			local columnHeight = height - floor

			if columnHeight > 0 then
				terrain:FillBlock(
					CFrame.new(cx, floor + columnHeight / 2, cz),
					Vector3.new(cell, columnHeight, cell),
					materialAt(cx, cz, height)
				)
			end

			-- Then flood the basin. Water goes in as a second pass on top of
			-- the ground column, from the carved floor up to the water line.
			--
			-- Confined to the pond on purpose: the hills dip below the water
			-- line in plenty of hollows, and without this check every one of
			-- them would fill, scattering grass-bottomed puddles with no banks
			-- or reeds across the whole map.
			if height < Config.waterLevel and World.distanceToPond(cx, cz) < Config.pondRadius then
				local depth = Config.waterLevel - height
				terrain:FillBlock(
					CFrame.new(cx, height + depth / 2, cz),
					Vector3.new(cell, depth, cell),
					Enum.Material.Water
				)
			end
		end
	end
end

local function newPart(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	return part
end

--[[
	One tree: a tapering trunk and three overlapping leaf clusters.

	The clusters are deliberately not concentric — offsetting and scaling them
	differently is what stops a tree reading as "a ball on a stick".
]]
local function plantTree(position: Vector3, rng: Random, parent: Instance)
	local tree = Instance.new("Model")
	tree.Name = "Tree"

	local height = rng:NextNumber(16, 26)
	local thickness = rng:NextNumber(2.2, 3.4)
	local lean = rng:NextNumber(-0.06, 0.06)

	local trunk = newPart(
		"Trunk",
		Vector3.new(height, thickness, thickness),
		CFrame.new(position + Vector3.new(0, height / 2 - 1, 0))
			* CFrame.Angles(lean, 0, math.rad(90) + lean),
		BARK,
		Enum.Material.Wood
	)
	trunk.Shape = Enum.PartType.Cylinder
	trunk.Parent = tree

	local crown = position + Vector3.new(0, height - 2, 0)
	for cluster = 1, 3 do
		local radius = rng:NextNumber(7, 11) * (1 - (cluster - 1) * 0.18)
		local offset = Vector3.new(
			rng:NextNumber(-3.5, 3.5),
			(cluster - 1) * rng:NextNumber(2.5, 4),
			rng:NextNumber(-3.5, 3.5)
		)

		local leaves = newPart(
			"Leaves",
			Vector3.new(radius, radius * 0.85, radius),
			CFrame.new(crown + offset),
			if cluster % 2 == 0 then LEAF_DARK else LEAF_LIGHT,
			Enum.Material.LeafyGrass
		)
		leaves.Shape = Enum.PartType.Ball
		leaves.CanCollide = false
		leaves.Parent = tree
	end

	tree.Parent = parent
end

--[[
	A cabin, built from plain Parts.

	Walls with openings are made from several pieces rather than one part, since
	Roblox has no way to cut a hole in a Part. A doorway is the two pieces beside
	it plus the header above it.
]]
local function buildHouse(origin: Vector3, parent: Instance)
	local house = Instance.new("Model")
	house.Name = "Cabin"

	local W, D, H = 28, 24, 14 -- width (X), depth (Z), wall height
	local halfW, halfD = W / 2, D / 2
	local t = 1 -- wall thickness
	local ox, oz = origin.X, origin.Z

	local function place(
		name: string,
		size: Vector3,
		offset: Vector3,
		color: Color3,
		material: Enum.Material
	)
		newPart(name, size, CFrame.new(origin + offset), color, material).Parent = house
	end

	-- Floor and a foundation lip so the cabin does not look like it is floating.
	place("Floor", Vector3.new(W, 1, D), Vector3.new(0, -0.5, 0), FLOOR, Enum.Material.WoodPlanks)
	place(
		"Foundation",
		Vector3.new(W + 2, 2, D + 2),
		Vector3.new(0, -2, 0),
		Color3.fromRGB(120, 118, 112),
		Enum.Material.Slate
	)

	-- Back wall: solid.
	place(
		"WallBack",
		Vector3.new(W, H, t),
		Vector3.new(0, H / 2, -halfD),
		WALL,
		Enum.Material.Sandstone
	)

	-- Front wall: a 7-wide, 10-tall doorway in the middle.
	local doorHalf = 3.5
	local doorTop = 10
	local sidePiece = (W / 2) - doorHalf
	place(
		"WallFrontLeft",
		Vector3.new(sidePiece, H, t),
		Vector3.new(-(doorHalf + sidePiece / 2), H / 2, halfD),
		WALL,
		Enum.Material.Sandstone
	)
	place(
		"WallFrontRight",
		Vector3.new(sidePiece, H, t),
		Vector3.new(doorHalf + sidePiece / 2, H / 2, halfD),
		WALL,
		Enum.Material.Sandstone
	)
	place(
		"DoorHeader",
		Vector3.new(doorHalf * 2, H - doorTop, t),
		Vector3.new(0, doorTop + (H - doorTop) / 2, halfD),
		BEAM,
		Enum.Material.Wood
	)

	-- Side walls: a band below the window, a band above it, and a post at each
	-- end to frame the opening.
	local sillY, headY = 5, 10
	local winHalf = 5
	local post = halfD - winHalf

	for _, side in { -1, 1 } do
		local x = side * halfW
		local label = if side < 0 then "Left" else "Right"

		place(
			"Wall" .. label .. "Lower",
			Vector3.new(t, sillY, D),
			Vector3.new(x, sillY / 2, 0),
			WALL,
			Enum.Material.Sandstone
		)
		place(
			"Wall" .. label .. "Upper",
			Vector3.new(t, H - headY, D),
			Vector3.new(x, headY + (H - headY) / 2, 0),
			WALL,
			Enum.Material.Sandstone
		)
		place(
			"Wall" .. label .. "PostA",
			Vector3.new(t, headY - sillY, post),
			Vector3.new(x, (sillY + headY) / 2, halfD - post / 2),
			WALL,
			Enum.Material.Sandstone
		)
		place(
			"Wall" .. label .. "PostB",
			Vector3.new(t, headY - sillY, post),
			Vector3.new(x, (sillY + headY) / 2, -(halfD - post / 2)),
			WALL,
			Enum.Material.Sandstone
		)

		local glass = newPart(
			"Window" .. label,
			Vector3.new(0.3, headY - sillY, winHalf * 2),
			CFrame.new(origin + Vector3.new(x, (sillY + headY) / 2, 0)),
			Color3.fromRGB(180, 214, 226),
			Enum.Material.Glass
		)
		glass.Transparency = 0.55
		glass.CanCollide = false
		glass.Parent = house
	end

	-- Gabled roof: two slabs leaning against each other.
	local rise = 8
	local run = halfW + 1.5 -- a little overhang past the walls
	local slope = math.atan2(rise, run)
	local slabLength = math.sqrt(run * run + rise * rise)

	for _, side in { -1, 1 } do
		local label = if side < 0 then "Left" else "Right"
		local slab = newPart(
			"Roof" .. label,
			Vector3.new(slabLength, 0.8, D + 4),
			CFrame.new(origin + Vector3.new(-side * run / 2, H + rise / 2, 0))
				* CFrame.Angles(0, 0, side * slope),
			ROOF,
			Enum.Material.Slate
		)
		slab.Parent = house
	end

	-- Triangular fill at each gable end, so the roof is not open to the sky.
	-- A WedgePart's vertical face is its +Z side and it slopes away toward -Z,
	-- so rotating 90 degrees about Y points that face at the ridge.
	for _, zEnd in { halfD, -halfD } do
		for _, side in { -1, 1 } do
			local wedge = Instance.new("WedgePart")
			wedge.Name = "Gable"
			wedge.Size = Vector3.new(t, rise, halfW)
			wedge.CFrame = CFrame.new(origin + Vector3.new(side * halfW / 2, H + rise / 2, zEnd))
				* CFrame.Angles(0, math.rad(-side * 90), 0)
			wedge.Color = WALL
			wedge.Material = Enum.Material.Sandstone
			wedge.Anchored = true
			wedge.Parent = house
		end
	end

	house.Parent = parent
end

--[[
	Small things on the ground: boulders, bushes and pond reeds.

	None of it is interactive — it exists so the eye has something to measure
	distance against. A hillside with nothing on it reads as flat no matter how
	well it is lit.
]]
local function scatterDetail(parent: Instance, housePosition: Vector3)
	local rng = Random.new(Config.worldSeed + 991)
	local half = Config.worldSize / 2 - 15

	local function pick(): (number, number, number, number)
		local x = rng:NextNumber(-half, half)
		local z = rng:NextNumber(-half, half)
		return x, z, World.heightAt(x, z), World.distanceToPond(x, z)
	end

	-- Boulders: anywhere except underwater and the immediate spawn area.
	for _ = 1, Config.rockCount do
		for _ = 1, 12 do
			local x, z, y, pondDistance = pick()
			if y > Config.waterLevel + 1 and math.sqrt(x * x + z * z) > 22 then
				local size = rng:NextNumber(3, 9)
				local rock = newPart(
					"Rock",
					Vector3.new(
						size,
						size * rng:NextNumber(0.5, 0.9),
						size * rng:NextNumber(0.7, 1.2)
					),
					CFrame.new(x, y + size * 0.15, z)
						* CFrame.Angles(
							rng:NextNumber(-0.3, 0.3),
							rng:NextNumber(0, 6.28),
							rng:NextNumber(-0.3, 0.3)
						),
					-- Boulders near the pond match the sand, not the grass.
					if pondDistance < Config.pondRadius + 14
						then Color3.fromRGB(168, 156, 132)
						else Color3.fromRGB(126, 124, 120),
					Enum.Material.Rock
				)
				rock.Parent = parent
				break
			end
		end
	end

	-- Bushes: clusters of squashed spheres, on grass only.
	for _ = 1, Config.bushCount do
		for _ = 1, 12 do
			local x, z, y, pondDistance = pick()
			if
				y > Config.waterLevel + 3
				and pondDistance > Config.pondRadius + 4
				and math.sqrt(x * x + z * z) > 18
			then
				local size = rng:NextNumber(3.5, 7)
				local bush = newPart(
					"Bush",
					Vector3.new(size, size * 0.7, size),
					CFrame.new(x, y + size * 0.25, z),
					if rng:NextNumber() < 0.5 then LEAF_DARK else LEAF_LIGHT,
					Enum.Material.LeafyGrass
				)
				bush.Shape = Enum.PartType.Ball
				bush.CanCollide = false
				bush.Parent = parent
				break
			end
		end
	end

	-- Reeds: thin blades, only in the shallows right at the water line.
	for _ = 1, Config.reedCount do
		for _ = 1, 12 do
			local x, z, y, pondDistance = pick()
			local inShallows = pondDistance < Config.pondRadius
				and y > Config.waterLevel - 2.5
				and y < Config.waterLevel + 1.2
			if inShallows then
				local height = rng:NextNumber(3, 6.5)
				local reed = newPart(
					"Reed",
					Vector3.new(0.35, height, 0.35),
					CFrame.new(x, y + height / 2, z)
						* CFrame.Angles(
							rng:NextNumber(-0.25, 0.25),
							rng:NextNumber(0, 6.28),
							rng:NextNumber(-0.25, 0.25)
						),
					Color3.fromRGB(118, 142, 78),
					Enum.Material.Grass
				)
				reed.CanCollide = false
				reed.Parent = parent
				break
			end
		end
	end
end

--[[
	Scatter trees over the map, skipping the clearing and the cabin.

	Candidates are rejected rather than nudged: nudging a rejected point tends
	to pile trees up against whatever pushed them away.
]]
local function plantForest(parent: Instance, housePosition: Vector3)
	local rng = Random.new(Config.worldSeed)
	local half = Config.worldSize / 2 - 20
	local planted = 0
	local attempts = 0

	while planted < Config.treeCount and attempts < Config.treeCount * 20 do
		attempts += 1

		local x = rng:NextNumber(-half, half)
		local z = rng:NextNumber(-half, half)
		local distance = math.sqrt(x * x + z * z)

		-- Keep the middle clear to play in, and do not grow a tree through the
		-- cabin roof.
		if distance < Config.treeClearRadius then
			continue
		end
		if
			(Vector3.new(x, 0, z) - Vector3.new(housePosition.X, 0, housePosition.Z)).Magnitude < 30
		then
			continue
		end

		local y = World.heightAt(x, z)
		plantTree(Vector3.new(x, y, z), rng, parent)
		planted += 1
	end

	return planted
end

--[[
	Build everything. Returns where the cabin was put, so callers can avoid it.
]]
function World.build(): Vector3
	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = Workspace

	--[[
		Terrain is resolved here rather than at module scope. Reading it when
		this module loads meant a place without one could not even be required,
		which took the entire server script down with it — no coins, no shop,
		no scoreboard, from one missing instance.

		Instance.new("Terrain") is not allowed, so if it is genuinely absent the
		only recourse is a Part.
	]]
	local terrain = Workspace:FindFirstChildOfClass("Terrain")

	if terrain then
		-- Animated grass blades on Grass terrain. One property, and it does
		-- more for how the ground reads than any amount of scattered geometry.
		terrain.Decoration = true
		terrain.GrassLength = 0.6

		-- Water styling. The default is a flat cyan; this is closer to a pond.
		terrain.WaterColor = Color3.fromRGB(38, 92, 104)
		terrain.WaterTransparency = 0.72
		terrain.WaterReflectance = 0.35
		terrain.WaterWaveSize = 0.06
		terrain.WaterWaveSpeed = 8

		generateTerrain(terrain)
	else
		groundIsFlat = true
		warn("[World] This place has no Terrain instance, so there are no hills and no pond.")
		warn(
			'[World] Fix: add "Terrain": { "$className": "Terrain" } under Workspace in the project file.'
		)

		local ground = newPart(
			"FallbackGround",
			Vector3.new(Config.worldSize, 4, Config.worldSize),
			CFrame.new(0, -2, 0),
			Color3.fromRGB(106, 140, 78),
			Enum.Material.Grass
		)
		ground.Parent = scenery
	end

	local housePosition = Vector3.new(0, 0, -Config.clearingRadius * 0.55)
	buildHouse(housePosition, scenery)

	local trees = plantForest(scenery, housePosition)
	scatterDetail(scenery, housePosition)

	print(
		string.format(
			"[World] %s built, %d trees planted",
			if groundIsFlat then "fallback ground" else "terrain and pond",
			trees
		)
	)

	return housePosition
end

return World
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>