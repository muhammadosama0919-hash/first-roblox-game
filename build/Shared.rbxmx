<roblox version="4">
  <Item class="Folder" referent="0">
    <Properties>
      <string name="Name">Shared</string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">Config</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Tunable values for the game.

	This module lives in ReplicatedStorage, which means both the server and the
	client can read it. Keeping numbers here instead of scattered through the
	code means you tweak gameplay in one place.
]]

export type Config = {
	-- How many coins award per pickup.
	coinValue: number,
	-- How many coins exist in the world at once.
	coinCount: number,
	-- Seconds before a collected coin comes back.
	coinRespawnSeconds: number,
	-- Coins spawn within this many studs of the origin.
	coinSpawnRadius: number,
	-- Height above the baseplate that coins float at.
	coinHeight: number,
	-- Spin speed, in radians per second (client-side visual only).
	coinSpinSpeed: number,
	-- How often to write progress to the DataStore while a player is online,
	-- so a server crash costs at most this much progress.
	autosaveSeconds: number,
	-- Humanoid stats before any shop bonuses. Roblox's own defaults.
	baseWalkSpeed: number,
	baseJumpPower: number,
	-- Hold Shift to run. Multiplies whatever the walk speed currently is, so
	-- it stacks with Swift Boots rather than overriding them.
	sprintMultiplier: number,
	-- Camera field of view, and how far it widens while sprinting. The widening
	-- is most of why running feels fast.
	baseFieldOfView: number,
	sprintFieldOfView: number,

	-- World generation.
	worldSeed: number,
	worldSize: number,
	terrainCell: number,
	terrainDepth: number,
	hillHeight: number,
	clearingRadius: number,
	clearingFalloff: number,
	treeCount: number,
	treeClearRadius: number,

	-- Pond. The basin is carved out of the terrain and then filled with water
	-- up to waterLevel, which sits below the rim so there is a visible bank.
	pondCenterX: number,
	pondCenterZ: number,
	pondRadius: number,
	pondDepth: number,
	pondBankWidth: number,
	waterLevel: number,

	-- Scattered ground detail: rocks, bushes, reeds.
	rockCount: number,
	bushCount: number,
	reedCount: number,
}

local Config: Config = {
	coinValue = 1,
	coinCount = 22,
	coinRespawnSeconds = 5,
	coinSpawnRadius = 145,
	coinHeight = 3,
	coinSpinSpeed = 2,
	autosaveSeconds = 60,
	baseWalkSpeed = 16,
	baseJumpPower = 50,
	sprintMultiplier = 1.65,
	baseFieldOfView = 70,
	sprintFieldOfView = 82,

	worldSeed = 20260913,
	worldSize = 420,
	terrainCell = 6,
	terrainDepth = 24,
	hillHeight = 17,
	clearingRadius = 72,
	clearingFalloff = 70,
	treeCount = 90,
	treeClearRadius = 34,

	pondCenterX = 86,
	pondCenterZ = 62,
	pondRadius = 46,
	pondDepth = 11,
	pondBankWidth = 26,
	waterLevel = -1.5,

	rockCount = 70,
	bushCount = 110,
	reedCount = 90,
}

return table.freeze(Config)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">CreatureAnimation</string>
        <string name="Source"><![CDATA[--!strict
--[[
	The creature's four animations, written as maths rather than keyframes.

	Roblox's normal animation route — the Animation Editor or an imported FBX —
	produces an asset that must be uploaded to Roblox before it can be played,
	because every AnimationClipProvider method takes an asset id. Driving
	Motor6D.Transform directly needs no upload at all, which is the only route
	that works when the game is delivered as a file.

	Each clip is a pure function of time returning joint name -> rotation. No
	state, no instances: the same inputs always give the same pose, so a clip
	can be evaluated on any machine at any framerate and match.

	Angles are radians, applied as CFrame.Angles(x, y, z) on top of the joint's
	rest pose. Positive X pitches a limb forward.
]]

export type Pose = { [string]: Vector3 }
export type Clip = {
	name: string,
	-- Seconds for one cycle. Attack does not loop; the rest do.
	length: number,
	looping: boolean,
	pose: (t: number) -> Pose,
}

local TAU = math.pi * 2

-- Ease that starts fast and settles, for strikes and snaps.
local function snap(t: number): number
	return 1 - (1 - t) ^ 3
end

-- Smooth 0->1->0, for anything that swells and returns.
local function pulse(t: number): number
	return math.sin(math.clamp(t, 0, 1) * math.pi)
end

local CreatureAnimation = {}

--[[
	A four-beat gait shared by walk and run.

	`stride` scales how far limbs travel, `lean` how far the body tips forward.
	Arms swing opposite the leg on the same side, which is what stops a walk
	reading as a shamble.
]]
local function gait(phase: number, stride: number, lean: number, bob: number): Pose
	local left = math.sin(phase * TAU)
	local right = math.sin(phase * TAU + math.pi)

	-- Knees bend on the recovery half of the stride only. Taking the absolute
	-- value doubles the frequency, which is what gives a knee its two bends
	-- per cycle instead of one.
	local kneeL = math.abs(math.sin(phase * TAU * 0.5 + math.pi * 0.25))
	local kneeR = math.abs(math.sin(phase * TAU * 0.5 + math.pi * 0.75))

	return {
		HumanoidRootPart = Vector3.new(0, 0, 0),
		Chest = Vector3.new(-lean + math.sin(phase * TAU * 2) * bob * 0.5, 0, 0),
		Neck = Vector3.new(lean * 0.7, math.sin(phase * TAU) * 0.06, 0),
		Head = Vector3.new(math.sin(phase * TAU * 2) * bob, 0, 0),

		ThighL = Vector3.new(left * stride, 0, 0),
		ShinL = Vector3.new(-kneeL * stride * 1.1, 0, 0),
		FootL = Vector3.new(kneeL * stride * 0.5, 0, 0),
		ThighR = Vector3.new(right * stride, 0, 0),
		ShinR = Vector3.new(-kneeR * stride * 1.1, 0, 0),
		FootR = Vector3.new(kneeR * stride * 0.5, 0, 0),

		-- Counter-swing: the arm opposite each leg.
		ArmUpperL = Vector3.new(right * stride * 0.75, 0, 0),
		ArmLowerL = Vector3.new(-math.abs(right) * stride * 0.4, 0, 0),
		ArmUpperR = Vector3.new(left * stride * 0.75, 0, 0),
		ArmLowerR = Vector3.new(-math.abs(left) * stride * 0.4, 0, 0),
	}
end

--[[
	WALK — deliberate, weight on each foot, head sweeping as if searching.
]]
local walk: Clip = {
	name = "walk",
	length = 1.25,
	looping = true,
	pose = function(t: number): Pose
		local phase = t % 1
		local p = gait(phase, 0.55, 0.30, 0.08)

		-- A slow head sweep on a different period from the stride, so the two
		-- never lock into an obvious repeating beat.
		p.Neck = Vector3.new(0.25, math.sin(t * TAU * 0.31) * 0.35, 0)
		p.Jaw = Vector3.new(0.06 + math.sin(t * TAU * 0.5) * 0.05, 0, 0)
		return p
	end,
}

--[[
	RUN — lower, faster, arms reaching. Nearly on all fours at full speed.
]]
local run: Clip = {
	name = "run",
	length = 0.52,
	looping = true,
	pose = function(t: number): Pose
		local phase = t % 1
		local p = gait(phase, 1.05, 0.72, 0.16)

		-- Arms drive rather than swing, and reach further forward than the legs.
		local left = math.sin(phase * TAU)
		local right = math.sin(phase * TAU + math.pi)
		p.ArmUpperL = Vector3.new(right * 1.25 - 0.35, 0, 0.1)
		p.ArmUpperR = Vector3.new(left * 1.25 - 0.35, 0, -0.1)
		p.ArmLowerL = Vector3.new(-0.55 - math.abs(right) * 0.35, 0, 0)
		p.ArmLowerR = Vector3.new(-0.55 - math.abs(left) * 0.35, 0, 0)

		p.Neck = Vector3.new(0.62, 0, 0)
		p.Head = Vector3.new(-0.25, 0, 0)
		p.Jaw = Vector3.new(0.3 + math.abs(math.sin(phase * TAU)) * 0.12, 0, 0)
		return p
	end,
}

--[[
	FEED — crouched over something on the ground, tearing at it.

	Two rhythms on purpose: a slow shoulder-and-spine rock, and a faster head
	wrench with the jaw snapping at the bottom of each pull. One rhythm alone
	reads as a machine.
]]
local feed: Clip = {
	name = "feed",
	length = 2.6,
	looping = true,
	pose = function(t: number): Pose
		local slow = math.sin(t * TAU)
		local wrench = math.sin(t * TAU * 3)
		local tear = math.max(0, math.sin(t * TAU * 3 - 0.6))

		return {
			-- Hunched right down, hips low.
			HumanoidRootPart = Vector3.new(0, 0, 0),
			Chest = Vector3.new(-0.95 + slow * 0.10, 0, 0),
			Neck = Vector3.new(1.05 + wrench * 0.22, slow * 0.08, 0),
			Head = Vector3.new(-0.35 - tear * 0.45, 0, wrench * 0.12),
			Jaw = Vector3.new(0.12 + tear * 0.55, 0, 0),

			-- Arms planted on the ground, pinning whatever it is down.
			ArmUpperL = Vector3.new(1.15, 0, 0.22),
			ArmLowerL = Vector3.new(-0.55 + tear * 0.18, 0, 0),
			ClawL = Vector3.new(0.4, 0, 0),
			ArmUpperR = Vector3.new(1.15, 0, -0.22),
			ArmLowerR = Vector3.new(-0.55 + tear * 0.18, 0, 0),
			ClawR = Vector3.new(0.4, 0, 0),

			-- Squatting, knees splayed out around the meal.
			ThighL = Vector3.new(1.25, 0, 0.18),
			ShinL = Vector3.new(-1.65, 0, 0),
			FootL = Vector3.new(0.65, 0, 0),
			ThighR = Vector3.new(1.25, 0, -0.18),
			ShinR = Vector3.new(-1.65, 0, 0),
			FootR = Vector3.new(0.65, 0, 0),
		}
	end,
}

--[[
	ATTACK — one shot, not a loop: coil, lunge, recover.

	The wind-up is the longest part and moves backwards. A strike that begins
	instantly has nothing to read, and a player cannot dodge what they cannot
	see coming.
]]
local attack: Clip = {
	name = "attack",
	length = 1.0,
	looping = false,
	pose = function(t: number): Pose
		local coil = math.clamp(t / 0.35, 0, 1)
		local strike = math.clamp((t - 0.35) / 0.2, 0, 1)
		local recover = math.clamp((t - 0.55) / 0.45, 0, 1)

		-- Rear back, then whip forward, then settle.
		local reach = -coil * 0.9 + snap(strike) * 2.3 - recover * 1.15
		local body = -coil * 0.45 + snap(strike) * 0.95 - recover * 0.5

		return {
			HumanoidRootPart = Vector3.new(0, 0, 0),
			Chest = Vector3.new(body - 0.3, 0, 0),
			Neck = Vector3.new(0.35 + snap(strike) * 0.3 - recover * 0.25, 0, 0),
			Head = Vector3.new(-coil * 0.3 + snap(strike) * 0.2, 0, 0),
			-- Jaw gapes through the wind-up and snaps shut on contact.
			Jaw = Vector3.new(coil * 0.85 - snap(strike) * 0.8 + pulse(recover) * 0.1, 0, 0),

			-- Claws lead, one slightly ahead of the other so it reads as a
			-- swipe rather than a shove.
			ArmUpperL = Vector3.new(reach, 0, 0.3 - coil * 0.25),
			ArmLowerL = Vector3.new(-0.7 + snap(strike) * 0.55, 0, 0),
			ClawL = Vector3.new(-0.3 + snap(strike) * 0.6, 0, 0),
			ArmUpperR = Vector3.new(reach * 0.88, 0, -0.3 + coil * 0.25),
			ArmLowerR = Vector3.new(-0.7 + snap(strike) * 0.4, 0, 0),
			ClawR = Vector3.new(-0.3 + snap(strike) * 0.45, 0, 0),

			-- Legs brace, then drive.
			ThighL = Vector3.new(0.35 + coil * 0.35 - snap(strike) * 0.3, 0, 0),
			ShinL = Vector3.new(-0.75 - coil * 0.3 + snap(strike) * 0.25, 0, 0),
			FootL = Vector3.new(0.4, 0, 0),
			ThighR = Vector3.new(0.35 + coil * 0.35 - snap(strike) * 0.3, 0, 0),
			ShinR = Vector3.new(-0.75 - coil * 0.3 + snap(strike) * 0.25, 0, 0),
			FootR = Vector3.new(0.4, 0, 0),
		}
	end,
}

CreatureAnimation.clips = {
	walk = walk,
	run = run,
	feed = feed,
	attack = attack,
}

-- Fraction through the attack at which the claws are actually out front. The
-- server uses this to decide when a swing can land, so the damage matches what
-- the player sees rather than firing on the wind-up.
CreatureAnimation.attackContact = 0.55

--[[
	Blend two poses. Used to cross-fade between clips so a state change does not
	snap, and to ease into the first frame of a one-shot.
]]
function CreatureAnimation.blend(from: Pose, into: Pose, alpha: number): Pose
	local out: Pose = {}
	local a = math.clamp(alpha, 0, 1)

	for joint, value in from do
		out[joint] = value:Lerp(into[joint] or Vector3.zero, a)
	end
	-- Joints only the target names still need to arrive from rest.
	for joint, value in into do
		if out[joint] == nil then
			out[joint] = Vector3.zero:Lerp(value, a)
		end
	end

	return out
end

return CreatureAnimation
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">CreatureRig</string>
        <string name="Source"><![CDATA[--!strict
--[[
	The skeleton of the creature, as data.

	A hunched, long-armed predator: roughly twice a player's height, with arms
	that reach near the ground, digitigrade back legs and an oversized jaw. The
	silhouette does the work — proportion and stance read as "not human" from
	far further away than surface detail ever does.

	Each joint names its parent, the size of the limb hanging off it, and where
	that limb attaches. Motor6D joints are built from this at runtime, so the
	rig is animated by rotating joints rather than by moving parts around.

	Every offset is in studs, measured from the parent part's centre.
]]

export type Limb = {
	name: string,
	parent: string,
	-- Size of this limb's part.
	size: Vector3,
	-- Where the joint sits on the PARENT, and on this limb. A joint rotates
	-- about the parent attachment, so it should sit at the limb's socket —
	-- a shoulder at the top of the upper arm, not at its middle.
	jointOnParent: Vector3,
	jointOnSelf: Vector3,
	-- Baked-in rotation, for limbs that hang at an angle when at rest.
	restAngles: Vector3?,
	color: Color3,
	shape: string?,
	transparency: number?,
}

local HIDE = Color3.fromRGB(96, 84, 78)
local HIDE_DARK = Color3.fromRGB(64, 56, 52)
local MAW = Color3.fromRGB(138, 74, 70)
local CLAW = Color3.fromRGB(196, 190, 176)

local CreatureRig = {}

-- The part everything else hangs from. Not in the limb list because it has no
-- parent joint; the Humanoid drives it directly.
CreatureRig.rootSize = Vector3.new(3.4, 2.6, 2.2)

--[[
	Ordered parent-before-child, so the builder can attach each limb to a parent
	that already exists without sorting.
]]
local LIMBS: { Limb } = {
	-- Spine. The chest sits forward of the hips, which is what produces the
	-- hunch without needing an animation to hold it there.
	{
		name = "Chest",
		parent = "HumanoidRootPart",
		size = Vector3.new(3.8, 2.8, 2.6),
		jointOnParent = Vector3.new(0, 1.3, 0),
		jointOnSelf = Vector3.new(0, -1.4, 0),
		restAngles = Vector3.new(-0.42, 0, 0),
		color = HIDE,
	},
	{
		name = "Neck",
		parent = "Chest",
		size = Vector3.new(1.5, 1.6, 1.5),
		jointOnParent = Vector3.new(0, 1.4, -0.7),
		jointOnSelf = Vector3.new(0, -0.8, 0),
		restAngles = Vector3.new(0.55, 0, 0),
		color = HIDE_DARK,
	},
	{
		name = "Head",
		parent = "Neck",
		size = Vector3.new(2.0, 1.7, 2.9),
		jointOnParent = Vector3.new(0, 0.8, 0),
		jointOnSelf = Vector3.new(0, -0.6, 0.5),
		color = HIDE,
	},
	{
		name = "Jaw",
		parent = "Head",
		size = Vector3.new(1.7, 0.7, 2.4),
		jointOnParent = Vector3.new(0, -0.7, 0.4),
		jointOnSelf = Vector3.new(0, 0.2, -1.0),
		color = MAW,
	},

	-- Arms. Long enough that the hands sit near the ground when it crouches,
	-- which is what sells the feeding pose.
	{
		name = "ArmUpperL",
		parent = "Chest",
		size = Vector3.new(1.1, 3.4, 1.1),
		jointOnParent = Vector3.new(-2.1, 0.9, 0),
		jointOnSelf = Vector3.new(0, 1.5, 0),
		restAngles = Vector3.new(0.25, 0, 0.18),
		color = HIDE,
	},
	{
		name = "ArmLowerL",
		parent = "ArmUpperL",
		size = Vector3.new(0.95, 3.2, 0.95),
		jointOnParent = Vector3.new(0, -1.6, 0),
		jointOnSelf = Vector3.new(0, 1.5, 0),
		restAngles = Vector3.new(0.4, 0, 0),
		color = HIDE_DARK,
	},
	{
		name = "ClawL",
		parent = "ArmLowerL",
		size = Vector3.new(0.9, 1.4, 1.6),
		jointOnParent = Vector3.new(0, -1.5, 0),
		jointOnSelf = Vector3.new(0, 0.6, 0),
		color = CLAW,
	},
	{
		name = "ArmUpperR",
		parent = "Chest",
		size = Vector3.new(1.1, 3.4, 1.1),
		jointOnParent = Vector3.new(2.1, 0.9, 0),
		jointOnSelf = Vector3.new(0, 1.5, 0),
		restAngles = Vector3.new(0.25, 0, -0.18),
		color = HIDE,
	},
	{
		name = "ArmLowerR",
		parent = "ArmUpperR",
		size = Vector3.new(0.95, 3.2, 0.95),
		jointOnParent = Vector3.new(0, -1.6, 0),
		jointOnSelf = Vector3.new(0, 1.5, 0),
		restAngles = Vector3.new(0.4, 0, 0),
		color = HIDE_DARK,
	},
	{
		name = "ClawR",
		parent = "ArmLowerR",
		size = Vector3.new(0.9, 1.4, 1.6),
		jointOnParent = Vector3.new(0, -1.5, 0),
		jointOnSelf = Vector3.new(0, 0.6, 0),
		color = CLAW,
	},

	-- Legs. Digitigrade: thigh forward, shin back, foot forward again. That
	-- double bend is the whole reason it does not walk like a person.
	{
		name = "ThighL",
		parent = "HumanoidRootPart",
		size = Vector3.new(1.4, 2.8, 1.4),
		jointOnParent = Vector3.new(-1.1, -1.2, 0),
		jointOnSelf = Vector3.new(0, 1.2, 0),
		restAngles = Vector3.new(0.5, 0, 0),
		color = HIDE,
	},
	{
		name = "ShinL",
		parent = "ThighL",
		size = Vector3.new(1.15, 3.0, 1.15),
		jointOnParent = Vector3.new(0, -1.3, 0),
		jointOnSelf = Vector3.new(0, 1.4, 0),
		restAngles = Vector3.new(-1.0, 0, 0),
		color = HIDE_DARK,
	},
	{
		name = "FootL",
		parent = "ShinL",
		size = Vector3.new(1.2, 0.7, 2.4),
		jointOnParent = Vector3.new(0, -1.4, 0),
		jointOnSelf = Vector3.new(0, 0.3, -0.6),
		restAngles = Vector3.new(0.5, 0, 0),
		color = HIDE_DARK,
	},
	{
		name = "ThighR",
		parent = "HumanoidRootPart",
		size = Vector3.new(1.4, 2.8, 1.4),
		jointOnParent = Vector3.new(1.1, -1.2, 0),
		jointOnSelf = Vector3.new(0, 1.2, 0),
		restAngles = Vector3.new(0.5, 0, 0),
		color = HIDE,
	},
	{
		name = "ShinR",
		parent = "ThighR",
		size = Vector3.new(1.15, 3.0, 1.15),
		jointOnParent = Vector3.new(0, -1.3, 0),
		jointOnSelf = Vector3.new(0, 1.4, 0),
		restAngles = Vector3.new(-1.0, 0, 0),
		color = HIDE_DARK,
	},
	{
		name = "FootR",
		parent = "ShinR",
		size = Vector3.new(1.2, 0.7, 2.4),
		jointOnParent = Vector3.new(0, -1.4, 0),
		jointOnSelf = Vector3.new(0, 0.3, -0.6),
		restAngles = Vector3.new(0.5, 0, 0),
		color = HIDE_DARK,
	},
}

CreatureRig.limbs = LIMBS

--[[
	Look up a limb by name. Used by the animator to check a joint exists before
	posing it, so a renamed limb is a no-op rather than an error every frame.
]]
function CreatureRig.find(name: string): Limb?
	for _, limb in CreatureRig.limbs do
		if limb.name == name then
			return limb
		end
	end

	return nil
end

return CreatureRig
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Shop</string>
        <string name="Source"><![CDATA[--!strict
--[[
	What the shop sells.

	This lives in ReplicatedStorage so the client can draw the shop menu from
	the same list the server charges against. The client using this list is a
	convenience, not a source of authority — the server re-reads every price
	from here when a purchase comes in, so a tampered client cannot invent an
	item or change what something costs.
]]

export type Item = {
	id: string,
	name: string,
	description: string,
	price: number,
	-- Effects. All optional; an item applies whichever ones it sets.
	walkSpeedBonus: number?,
	jumpPowerBonus: number?,
	coinMultiplier: number?,
}

-- Order here is the order they appear in the menu.
local ITEMS: { Item } = {
	{
		id = "swiftBoots",
		name = "Swift Boots",
		description = "Move noticeably faster.",
		price = 25,
		walkSpeedBonus = 8,
	},
	{
		id = "springLegs",
		name = "Spring Legs",
		description = "Jump half again as high.",
		price = 50,
		jumpPowerBonus = 25,
	},
	{
		id = "luckyCharm",
		name = "Lucky Charm",
		description = "Every coin is worth double.",
		price = 100,
		coinMultiplier = 2,
	},
}

local Shop = {}

Shop.items = ITEMS

function Shop.getItem(id: string): Item?
	for _, item in Shop.items do
		if item.id == id then
			return item
		end
	end

	return nil
end

return Shop
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>