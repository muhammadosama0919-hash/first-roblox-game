--!strict
--[[
	Puts the manor in the world, or looks after one that was put there by hand.

	Two ways the house can arrive:

	  1. Built here from Manor.luau, at PIVOT below. The ground is found by a
	     ray cast down onto the Terrain, retried for a while because the
	     terrain is generated by another script and this one may well run
	     first.

	  2. Inserted in Studio from build/Manor.rbxm and saved in the place. Then
	     a Model named "Manor" already exists when the server starts, and this
	     script must NOT build a second one. It still has a job: the world
	     generator does not know the house is there and will plant trees
	     through the parlour, so the footprint gets cleared either way.

	Kept apart from Main.server.luau on purpose. This file can be deleted, or
	PIVOT changed, without touching anything that already works, and it reads
	neither World nor Config, so nothing that changes in either can break it.
]]

local Workspace = game:GetService("Workspace")

-- Where the house stands and which way it faces, if it is built here. X and
-- Z are the middle of its footprint; the porch and front door are on the
-- side the pivot looks toward. Y is only used if the ground cannot be found.
-- Ignored entirely when a Manor model is already in the place.
local PIVOT = CFrame.new(0, 0, -170) * CFrame.Angles(0, math.rad(0), 0)

-- How long to keep looking for the ground, and for the scenery, before giving
-- up on each.
local GROUND_TIMEOUT = 12
local SCENERY_TIMEOUT = 12

-- Scenery that gets removed from under the house. These are the names the
-- world generator gives them; a name not in this list is left alone.
local CLEARABLE = { Tree = true, Bush = true, Rock = true, Reed = true }

-- How far past the house's own edge the clearing reaches, for a hand-placed
-- model. A tree whose trunk just misses the wall still puts its crown through
-- the bedroom.
local CLEAR_MARGIN = 4

local ok, Manor = pcall(function()
	local module = script.Parent:WaitForChild("Manor", 10)
	if not module then
		error("Manor.luau is not next to this script")
	end
	return require(module)
end)

if not ok then
	warn("[ManorSpawn] Not building the manor: " .. tostring(Manor))
	return
end

--[[
	Ground height under a point, from the terrain only. Parts are ignored so
	the ray does not land on the roof of something already standing there.
]]
local function groundUnder(x: number, z: number): number?
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { terrain }

	local hit = Workspace:Raycast(Vector3.new(x, 500, z), Vector3.new(0, -1000, 0), params)
	return if hit then hit.Position.Y else nil
end

--[[
	The Scenery folder, once the generator has finished filling it.

	"Finished" is judged by the child count holding still for a second: the
	generator may yield partway through planting, and clearing the footprint
	before it is done would leave the trees planted after the clearing.
]]
local function sceneryWhenSettled(): Folder?
	local deadline = os.clock() + SCENERY_TIMEOUT
	local lastCount = -1
	local stableSince = os.clock()

	while os.clock() < deadline do
		local scenery = Workspace:FindFirstChild("Scenery")
		if scenery and scenery:IsA("Folder") then
			local count = #scenery:GetChildren()
			if count ~= lastCount then
				lastCount = count
				stableSince = os.clock()
			elseif count > 0 and os.clock() - stableSince >= 1 then
				return scenery
			end
		end
		task.wait(0.25)
	end

	return nil
end

--[[
	Remove clearable scenery whose position `inside` says is under the house.
]]
local function clearSite(inside: (Vector3) -> boolean): number
	local scenery = sceneryWhenSettled()
	if not scenery then
		warn(
			"[ManorSpawn] No settled Workspace.Scenery folder found; nothing cleared from under the manor"
		)
		return 0
	end

	local cleared = 0
	for _, thing in scenery:GetChildren() do
		if
			CLEARABLE[thing.Name]
			and thing:IsA("PVInstance")
			and inside(thing:GetPivot().Position)
		then
			thing:Destroy()
			cleared += 1
		end
	end
	return cleared
end

----------------------------------------------------------------------------
-- A manor already in the place: keep it, clear under it, stop.
----------------------------------------------------------------------------

local placed = Workspace:FindFirstChild("Manor")
if placed and placed:IsA("Model") then
	local box, size = placed:GetBoundingBox()
	local cleared = clearSite(function(position: Vector3): boolean
		local rel = box:PointToObjectSpace(position)
		return math.abs(rel.X) < size.X / 2 + CLEAR_MARGIN
			and math.abs(rel.Z) < size.Z / 2 + CLEAR_MARGIN
	end)

	print(
		string.format(
			"[ManorSpawn] Found a Manor model already in the place at (%.0f, %.0f, %.0f); not building another. %d scenery cleared from under it",
			box.X,
			box.Y,
			box.Z,
			cleared
		)
	)
	return
end

----------------------------------------------------------------------------
-- Otherwise build one at PIVOT, on the ground.
----------------------------------------------------------------------------

local pivot = PIVOT
local deadline = os.clock() + GROUND_TIMEOUT
local groundY: number? = nil

while os.clock() < deadline do
	groundY = groundUnder(PIVOT.X, PIVOT.Z)
	if groundY then
		break
	end
	task.wait(0.25)
end

if groundY then
	pivot = CFrame.new(PIVOT.X, groundY, PIVOT.Z) * PIVOT.Rotation
else
	warn(
		string.format(
			"[ManorSpawn] No terrain found under (%.0f, %.0f) after %ds; building at Y = %.0f",
			PIVOT.X,
			PIVOT.Z,
			GROUND_TIMEOUT,
			PIVOT.Y
		)
	)
end

local builtOk, built = pcall(Manor.build, pivot, Workspace)
if not builtOk then
	warn("[ManorSpawn] Manor.build failed: " .. tostring(built))
	return
end

-- Cleared after the build rather than before, so the generator cannot plant
-- something new in the gap between clearing and building.
local footprint = Manor.FOOTPRINT
local cleared = clearSite(function(position: Vector3): boolean
	local rel = pivot:PointToObjectSpace(position)
	return rel.X > footprint.x0
		and rel.X < footprint.x1
		and rel.Z > footprint.z0
		and rel.Z < footprint.z1
end)

print(
	string.format(
		"[ManorSpawn] Manor at (%.0f, %.0f, %.0f): %d parts, %d hiding places tagged HidingSpot, %d scenery cleared",
		pivot.X,
		pivot.Y,
		pivot.Z,
		built.partCount,
		#built.hidingSpots,
		cleared
	)
)
