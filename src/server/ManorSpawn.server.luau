--!strict
--[[
	Puts the manor in the world.

	Kept apart from Main.server.luau on purpose. This file can be deleted, or
	PIVOT below changed, without touching anything that already works, and it
	reads neither World nor Config, so nothing that changes in either can
	break it.

	It finds the ground itself: a ray cast down onto the Terrain at the chosen
	spot, retried for a while because the terrain is generated by another
	script and this one may well run first. If no terrain ever turns up, the
	house is built at the Y given here and the Output window says so.
]]

local Workspace = game:GetService("Workspace")

-- Where the house stands and which way it faces. X and Z are the middle of
-- its footprint; the porch and front door are on the side the pivot looks
-- toward. Y is only used if the ground cannot be found. Change these to move
-- it or turn it.
local PIVOT = CFrame.new(0, 0, -170) * CFrame.Angles(0, math.rad(0), 0)

-- How long to keep looking for the ground before giving up on it.
local GROUND_TIMEOUT = 12

-- Scenery that gets removed from under the house once it is built. A tree
-- through the parlour is worse than no tree, and these are the names the
-- world generator gives them.
local CLEARABLE = { Tree = true, Bush = true, Rock = true, Reed = true }

local ok, Manor = pcall(function()
	local module = script.Parent:WaitForChild("Manor", 10)
	if not module then
		error("Manor.luau is not next to this script")
	end
	return require(module)
end)

if not ok then
	warn("[ManorSpawn] Not building the manor: " .. tostring(Manor))
	return
end

--[[
	Ground height under the pivot, from the terrain only. Parts are ignored so
	the ray does not land on the roof of something already standing there.
]]
local function groundUnder(x: number, z: number): number?
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { terrain }

	local hit = Workspace:Raycast(Vector3.new(x, 500, z), Vector3.new(0, -1000, 0), params)
	return if hit then hit.Position.Y else nil
end

local pivot = PIVOT
local deadline = os.clock() + GROUND_TIMEOUT
local groundY: number? = nil

while os.clock() < deadline do
	groundY = groundUnder(PIVOT.X, PIVOT.Z)
	if groundY then
		break
	end
	task.wait(0.25)
end

if groundY then
	pivot = CFrame.new(PIVOT.X, groundY, PIVOT.Z) * PIVOT.Rotation
else
	warn(
		string.format(
			"[ManorSpawn] No terrain found under (%.0f, %.0f) after %ds; building at Y = %.0f",
			PIVOT.X,
			PIVOT.Z,
			GROUND_TIMEOUT,
			PIVOT.Y
		)
	)
end

local builtOk, built = pcall(Manor.build, pivot, Workspace)
if not builtOk then
	warn("[ManorSpawn] Manor.build failed: " .. tostring(built))
	return
end

-- Clear the site. Done after the build rather than before, so the scenery
-- generator (which may still be running) cannot plant something new in the
-- gap between clearing and building.
local cleared = 0
local scenery = Workspace:FindFirstChild("Scenery")
if scenery then
	local footprint = Manor.FOOTPRINT
	for _, thing in scenery:GetChildren() do
		if not CLEARABLE[thing.Name] or not thing:IsA("PVInstance") then
			continue
		end

		local rel = pivot:PointToObjectSpace(thing:GetPivot().Position)
		if
			rel.X > footprint.x0
			and rel.X < footprint.x1
			and rel.Z > footprint.z0
			and rel.Z < footprint.z1
		then
			thing:Destroy()
			cleared += 1
		end
	end
end

print(
	string.format(
		"[ManorSpawn] Manor at (%.0f, %.0f, %.0f): %d parts, %d hiding places tagged HidingSpot, %d scenery cleared",
		pivot.X,
		pivot.Y,
		pivot.Z,
		built.partCount,
		#built.hidingSpots,
		cleared
	)
)
